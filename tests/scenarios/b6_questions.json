  {
    "id": "b6-customer-correction",
    "question": 2,
    "title": "Correct the customer without restarting",
    "values": {
      "first_customer": {
        "sql": "SELECT name FROM customers ORDER BY customer_id LIMIT 1"
      },
      "other_customer": {
        "sql": "SELECT name FROM customers ORDER BY customer_id LIMIT 1 OFFSET 1"
      },
      "other_id": {
        "sql": "SELECT customer_id FROM customers WHERE name = :other_customer"
      },
      "other_owed": {
        "sql": "SELECT COALESCE(ROUND(SUM(amount), 2), 0) FROM invoices WHERE customer_id = :other_id AND paid_date IS NULL AND writeoff_date IS NULL"
      }
    },
    "turns": [
      {
        "say": "How much does {first_customer} owe me?"
      },
      {
        "say": "No, I meant {other_customer}. How much do they owe?"
      }
    ],
    "must_call": [
      {
        "action": [
          "get_customer",
          "get_receivables"
        ],
        "arguments": {
          "customer": "{other_customer}"
        }
      }
    ],
    "figures": [
      "other_owed"
    ]
  },
