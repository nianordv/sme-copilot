{
  "model": "LightGBM discrete daily payment hazard",
  "objective": "binary",
  "metric": "binary_logloss",
  "boosting_type": "gbdt",
  "n_estimators": 500,
  "learning_rate": 0.05,
  "max_depth": 4,
  "num_leaves": 8,
  "min_child_samples": 200,
  "reg_lambda": 5.0,
  "subsample": 1.0,
  "subsample_freq": 0,
  "colsample_bytree": 1.0,
  "max_bin": 255,
  "n_jobs": 1,
  "random_state": 42,
  "deterministic": true,
  "force_col_wise": true,
  "device_type": "cpu"
}
